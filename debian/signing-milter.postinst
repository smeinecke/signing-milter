#!/bin/sh
# postinst script for signing-milter
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package


case "$1" in
    configure)
        echo "Setting up signing-milter group and user"
        # creating signing-milter group if he isn't already there
        if ! getent group signing-milter >/dev/null; then
            # Adding system group: signing-milter.
            addgroup --system signing-milter >/dev/null
        fi

        # creating signing-milter user if he isn't already there
        if ! getent passwd signing-milter >/dev/null; then
            # Adding system user: signing-milter.
            adduser \
            --system \
            --disabled-login \
            --ingroup signing-milter \
            --no-create-home \
            --home /nonexistent \
            --gecos "signing-milter" \
            --shell /bin/false \
            signing-milter >/dev/null
        fi

        chgrp signing-milter /etc/signing-milter/
        chmod 0750 /etc/signing-milter/

        # Create and secure the milter socket directory.  signing-milter starts
        # as root and the socket directory must therefore be owned by root
        # (CWE-367), but the postfix group needs search access.
        SOCKET_DIR="/run/signing-milter"
        if [ -f /etc/default/signing-milter ]; then
            # shellcheck disable=SC1091
            . /etc/default/signing-milter
        fi
        socket_path="$(printf '%s' "$OPTIONS" | sed -n 's/.*-s[[:space:]]\+\([^[:space:]]\+\).*/\1/p')"
        if [ -n "$socket_path" ]; then
            case "$socket_path" in
                unix:*|local:*)
                    socket_path="${socket_path#*:}"
                    socket_path="${socket_path#//}"
                    SOCKET_DIR="$(dirname "$socket_path")"
                    ;;
            esac
        fi
        if [ -n "$SOCKET_DIR" ]; then
            mkdir -p "$SOCKET_DIR"
            if getent group postfix >/dev/null; then
                chown root:postfix "$SOCKET_DIR" 2>/dev/null || true
            else
                chown root:root "$SOCKET_DIR" 2>/dev/null || true
            fi
            chmod 0750 "$SOCKET_DIR" 2>/dev/null || true
        fi

        # Migrate old German variable names to the new English ones,
        # preserving their assigned values.
        if [ -f /etc/default/signing-milter ] &&
           grep -q 'STATISTIK_LOGGING' /etc/default/signing-milter; then
            sed -i \
                -e 's/DISABLE_HOURLY_STATISTIK_LOGGING/DISABLE_HOURLY_STATISTICS_LOGGING/g' \
                -e 's/DISABLE_DAILY_STATISTIK_LOGGING/DISABLE_DAILY_STATISTICS_LOGGING/g' \
                /etc/default/signing-milter
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
